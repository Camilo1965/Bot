# Vibe-Trading MCP configuration
# Copy this file to .env and fill in your keys.
# This file is read by the vibe-trading-mcp subprocess.

# LLM provider: gemini (recommended) or deepseek
LANGCHAIN_PROVIDER=gemini

# Google Gemini API key (required for gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name for the LLM provider
LANGCHAIN_MODEL_NAME=gemini-2.0-flash

# Tushare token (optional, for A-share market data)
TUSHARE_TOKEN=

# Request timeout in seconds
TIMEOUT_SECONDS=120