# ── Execution mode ────────────────────────────────────────────────────────────
# mt5  – MetaTrader 5 (requires running MT5 terminal + credentials below).
# paper – Internal simulation only (bot will exit: market feed requires MT5).
EXECUTION_MODE=mt5

# Trading profile (optional — defaults: max-performance validated sweep)
BUY_PROB_THRESHOLD=0.50
RISK_PER_TRADE=0.05
# TTL_HOURS=12

# ── MetaTrader 5 (required when EXECUTION_MODE=mt5) ───────────────────────────
# MT5_LOGIN: integer account number. MT5_SERVER: exact name shown in MT5.
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Demo

# MT5_TICK_INTERVAL_S: seconds between tick polls per watchlist cycle (lower = snappier SL/TP & dashboard).
# MT5_KLINE_POLL_S: how often to poll closed candles for ATR / HTF (keep ≥1 to avoid terminal load).
# MT5_POSITION_SYNC_S: periodic ghost/ticket reconcile with MT5 (seconds). Lower = fresher UI vs more IPC.
MT5_TICK_INTERVAL_S=0.25
MT5_KLINE_POLL_S=5
MT5_POSITION_SYNC_S=4

# Dashboard: MT5 sync before Rich TUI refresh (seconds). 0 = disable that sync.
DASHBOARD_MT5_SYNC_EVERY_S=2
# Web SPA (~2.5s poll): min interval between full syncs on /api/state. 0 = sync every API hit (freshest vs broker).
WEB_API_MT5_SYNC_MIN_INTERVAL_S=0
# Legacy alias still read if MIN_INTERVAL unset:
# WEB_API_MT5_SYNC_EVERY_S=0

# Block new bot LONG if MT5 already shows a non-bot long on same symbol (manual trade). 1 = allow stacking (risky).
MT5_ALLOW_FOREIGN_SYMBOL_OVERLAP=0

# Market queue: max messages drained per consumer iteration (burst); collapses to latest tick per symbol.
MARKET_QUEUE_BURST_MAX=512

# Health: when queue or stale feed exceeds thresholds, force sync_positions_with_exchange (MT5 live only).
HEALTH_FORCE_SYNC_QUEUE=800
HEALTH_FORCE_SYNC_STALE_S=90
HEALTH_FORCE_SYNC_INTERVAL_S=15

# MT5_DASHBOARD_PRICE: which quote to show in the dashboard — mid (default), bid, or ask.
MT5_DASHBOARD_PRICE=mid

# Rich TUI + consola + panel eventos: reloj en hora local (IANA). Si no se define, usa REPORT_TIMEZONE.
# DASHBOARD_TIMEZONE=America/Bogota
# REPORT_TIMEZONE=America/Bogota

# Optional JSON object: map internal / MT5 keys → exact broker symbol (Market Watch name).
# Needed when defaults like SOLUSD-T do not exist on your server (mt5.symbol_info returns None).
# Admirals MT5 DOGE CFD is usually ``DGEUSD-T`` (broker spelling). Override if needed:
# MT5_SYMBOL_OVERRIDES={"DOGE/USDT":"DGEUSD-T","DOGEUSD":"DGEUSD-T"}

# ── Database (PostgreSQL; hypertables need TimescaleDB extension) ─────────────
DB_USER=clawdbot
DB_PASSWORD=clawdbot_secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clawdbot
# Per-query timeout for asyncpg (seconds). 0 = no timeout.
DB_COMMAND_TIMEOUT_S=90

# ── Web dashboard (aiohttp :8080) ────────────────────────────────────────────
# Max /api/state requests per IP per rolling minute (0 = disable limit). Stops scan spam.
DASH_API_RATE_PER_MIN=180
# 1/true/yes → hide aiohttp access INFO (GET /api/state spam in logs).
DASH_QUIET_ACCESS_LOG=

# ── Redis (optional for this codebase path; not required by main.py) ──────────
REDIS_URL=redis://localhost:6379/0

# ── Gemini LLM (sentiment; optional — bot uses neutral baseline if empty) ─────
GEMINI_API_KEY=

# ── Telegram (optional alerts) ─────────────────────────────────────────────────
# Required for trade/health alerts: create bot via @BotFather, get chat id (user or group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
